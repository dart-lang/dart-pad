.DS_Store

# Don’t commit the following directories created by pub.
build/
.buildlog
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock

# Or the files created by dart2js.
*.dart.js
*.js.deps

# Python generated files
*.pyc

# IDE configuration
.idea/

# Diagrams created by https://pub.dev/packages/layerlens
**/DEPENDENCIES.md

# Artifacts of failed golden testing
**/*_masterImage.png
**/*_testImage.png

# Generated sample archives are build inputs for the preview frontend.
pkgs/dartpad_preview/dartpad_frontend/web/samples/
