{
  "hosting": {
    "site": "sketch-pad-1cebb",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "404.html",
        "headers": [
          { "key": "Cache-Control", "value": "max-age=0, must-revalidate" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "!/@(assets)/**",
        "destination": "/index.html"
      }
    ]
  }
}
